{
    "name": "presto",
    "private": true,
    "version": "1.0.0",
    "license": "GPL-3.0-or-later",
    "scripts": {
        "format": "prettier --write .",
        "build": "esbuild src/frontend.js --bundle --format=iife --global-name=PrestoBundle --target=es2020 --outfile=assets/dist/frontend.js --legal-comments=eof --banner:js=\"/*! Third-party notices: see ../../third-party-notices.txt. */\" --banner:css=\"/*! Third-party notices: see ../../third-party-notices.txt. */\"",
        "zip": "wp --allow-root dist-archive . ../presto.zip --plugin-dirname=presto --force"
    },
    "dependencies": {
        "@schedule-x/calendar": "^4.6.0",
        "@schedule-x/theme-default": "^4.6.0",
        "temporal-polyfill": "^0.3.0"
    },
    "devDependencies": {
        "esbuild": "^0.25.0",
        "prettier": "^3.8.4",
        "prettier-plugin-brace-style": "^0.10.1",
        "prettier-plugin-css-order": "^2.2.0",
        "prettier-plugin-merge": "^0.10.1"
    },
    "prettier": {
        "braceStyle": "stroustrup",
        "printWidth": 400,
        "semi": true,
        "singleQuote": false,
        "tabWidth": 4,
        "trailingComma": "none",
        "useTabs": false,
        "plugins": [
            "prettier-plugin-css-order",
            "prettier-plugin-brace-style",
            "prettier-plugin-merge"
        ]
    }
}
